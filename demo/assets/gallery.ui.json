                { "type": "TextLabel", "id": "cap_a3_state", "text": "state: (untouched)", "size": { "w": 700, "h": 20 } },

                { "type": "Separator", "id": "cap_sep_c1", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "cap_c1_lbl", "text": "C1 - Tooltip: hover the button below; passive timer (UIManager-driven) shows the tip after 0.5s", "size": { "w": 900, "h": 20 } },
                { "type": "Button", "id": "cap_c1_btn", "text": "Hover me", "size": { "w": 140, "h": 28 } },
                { "type": "TextLabel", "id": "cap_c1_state", "text": "tooltip: (idle)", "size": { "w": 500, "h": 20 } },

                { "type": "Separator", "id": "cap_sep_c2", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "cap_c2_lbl", "text": "C2 - ComboBox typeahead: focus the box and type a letter; popup opens and jumps to matching item", "size": { "w": 900, "h": 20 } },

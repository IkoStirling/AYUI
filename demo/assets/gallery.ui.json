                      }
                    },
                    {
                      "slot": "Center",
                      "id": "card_center",
                      "title": "Center",
                      "floatable": true,
                      "headerHeight": 22,
                      "content": {
                        "type": "Panel",
                        "id": "dock_center_body",
                        "padding": { "left": 8, "top": 6, "right": 8, "bottom": 6 },

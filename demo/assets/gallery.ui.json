                { "type": "TextLabel", "id": "cap_c2_state", "text": "typeahead: (idle)", "size": { "w": 500, "h": 20 } },

                { "type": "Separator", "id": "cap_sep_c3", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "cap_c3_lbl", "text": "C3 - Menu typeahead: open the menu, then type a letter to jump highlight (does not close menu)", "size": { "w": 900, "h": 20 } },
                {
                  "type": "MenuBar",
                  "id": "cap_c3_bar",
                  "size": { "w": 320, "h": 28 }
                },
                { "type": "TextLabel", "id": "cap_c3_state", "text": "menu: (idle)", "size": { "w": 500, "h": 20 } },

                { "type": "Separator", "id": "cap_sep_b3", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "cap_b3_lbl", "text": "B3 - Wheel routing: scroll the wheel over the ListView below; outer ScrollView stays put", "size": { "w": 900, "h": 20 } },
                {
                  "type": "ListView",
                  "id": "cap_b3_list",
                  "size": { "w": 320, "h": 110 }
                },
                { "type": "TextLabel", "id": "cap_b3_state", "text": "wheel: (idle)", "size": { "w": 500, "h": 20 } }
              ]
            },
            {
              "type": "VBox",
              "id": "page_backend",
              "spacing": 10,
              "padding": { "left": 16, "top": 12, "right": 16, "bottom": 12 },
              "children": [
                { "type": "TextLabel", "id": "backend_hdr", "text": "Backend - UIRenderBackend: gradient / SDF / texture / vector path / stencil clip", "size": { "w": 920, "h": 24 } },
                { "type": "TextLabel", "id": "backend_hint", "text": "The canvas covers concave fill, stroke, holes, curves and arbitrary-shape clipping through the production backend.", "size": { "w": 900, "h": 20 } }
              ]
            },
            {
              "type": "VBox",
              "id": "page_animation",
              "spacing": 10,
              "padding": { "left": 16, "top": 12, "right": 16, "bottom": 12 },
              "children": [
                { "type": "TextLabel", "id": "anim_hdr", "text": "Animation - hover transitions / popup fade + slide-in / opacity / scroll momentum / indeterminate scan / spinner", "size": { "w": 920, "h": 24 } },
                { "type": "TextLabel", "id": "anim_hint", "text": "Buttons below tween their fill on hover/press. Menus, ComboBox popups, Modals and Tooltips fade in on open and fade out on close.", "size": { "w": 900, "h": 20 } },

                { "type": "Separator", "id": "anim_sep_demo", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "anim_demo_lbl", "text": "Hover / press transition demo (90ms color tween on the fallback fill)", "size": { "w": 900, "h": 20 } },
                { "type": "Button", "id": "anim_btn1", "text": "Hover me (90ms)", "size": { "w": 200, "h": 28 } },
                { "type": "Button", "id": "anim_btn2", "text": "Hover me too", "size": { "w": 200, "h": 28 } },
                { "type": "Button", "id": "anim_btn3", "text": "Press me", "size": { "w": 200, "h": 28 } },

                { "type": "Separator", "id": "anim_sep_fade", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "anim_fade_lbl", "text": "Opacity toggle (200ms) - click the button to fade the panel below in/out", "size": { "w": 900, "h": 20 } },
                { "type": "Button", "id": "btn_fade_toggle", "text": "Toggle panel opacity", "size": { "w": 200, "h": 28 } },

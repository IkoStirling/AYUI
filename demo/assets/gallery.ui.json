                      ]
                    },
                    {
                      "type": "Panel",
                      "id": "image_crop_panel",
                      "size": { "w": 280, "h": 136 },
                      "slot": { "width": 280 },
                      "children": [
                        { "type": "TextLabel", "id": "image_crop_label", "text": "UV crop (top-right tile)", "position": { "x": 10, "y": 6 }, "size": { "w": 220, "h": 20 } },
                        { "type": "Image", "id": "img_texture_crop", "position": { "x": 10, "y": 30 }, "size": { "w": 260, "h": 96 } }

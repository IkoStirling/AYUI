            { "type": "Button", "id": "nav_input", "text": "3. Input", "size": { "w": 160, "h": 28 } },
            { "type": "Button", "id": "nav_collections", "text": "4. Collections", "size": { "w": 160, "h": 28 } },
            { "type": "Button", "id": "nav_overlay", "text": "5. Overlay", "size": { "w": 160, "h": 28 } },
            { "type": "Button", "id": "nav_layout", "text": "6. Layout", "size": { "w": 160, "h": 28 } },
            { "type": "Button", "id": "nav_capabilities", "text": "7. Capabilities", "size": { "w": 160, "h": 28 } },
            { "type": "Button", "id": "nav_backend", "text": "8. Backend", "size": { "w": 160, "h": 28 } },

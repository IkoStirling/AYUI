                      "slot": "Right",
                      "id": "card_right",
                      "title": "Right",
                      "floatable": true,
                      "content": {
                        "type": "VBox",
                        "id": "dock_right_body",
                        "spacing": 4,
                        "padding": { "left": 8, "top": 6, "right": 8, "bottom": 6 },
                        "children": [
                          { "type": "TextLabel", "id": "dock_right_lbl", "text": "Dock Right card", "size": { "w": 160, "h": 22 } },
                          { "type": "Slider", "id": "dock_right_sld", "size": { "w": 140, "h": 22 } }

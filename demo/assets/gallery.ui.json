                },

                { "type": "Separator", "id": "anim_sep_scan", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "anim_scan_lbl", "text": "Indeterminate scan (1.6s sweep) + Spinner orbit (0.9s/rev)", "size": { "w": 900, "h": 20 } },
                { "type": "Button", "id": "btn_scan_toggle", "text": "Toggle indeterminate", "size": { "w": 200, "h": 28 } },
                { "type": "ProgressBar", "id": "prg_scan", "size": { "w": 200, "h": 16 } },
                { "type": "Spinner", "id": "spinner_demo", "size": { "w": 24, "h": 24 } },

                { "type": "Separator", "id": "anim_sep_ts", "size": { "w": 900, "h": 6 } },
                { "type": "TextLabel", "id": "anim_ts_hint", "text": "TabStrip indicator slides (120ms) - tabs below are cpp-built", "size": { "w": 900, "h": 20 } }
